# BUSY Bar Lab configuration — copy to .env and edit.
#
# Format: one KEY=value per line, '#' starts a comment. Surrounding quotes are
# stripped, so SKYSTRIP_TZ="Etc/UTC" and SKYSTRIP_TZ=Etc/UTC
# are the same thing — but only matched pairs, so a value can still contain a
# quote. `KEY=` means "explicitly blank", which is different from leaving the
# key out; several settings below document blank as a real choice.
#
# This file is the complete operator contract: every key the apps and
# barkeep read is here, and a test enforces both directions
# (tests/test_registry.py), so if your .env has extras from an older install
# they are doing nothing — SKYSTRIP_SPEAKER is one such leftover. The one
# internal exception is BARKEEP_MANAGED, which barkeep sets for its child
# processes; it never belongs in this file.
# Most of this is optional and falls back to a sane default. The
# COORDINATES ARE NOT: without them you get the sky at 0,0, which is a
# point in the Gulf of Guinea where nobody lives.

# Where your sky is (decimal degrees; find yours at latlong.net).
# REQUIRED AS A PAIR — blank is unconfigured. Latitude or longitude may
# legitimately be zero; what is invalid is setting only one of them.
SKYSTRIP_LAT=
SKYSTRIP_LON=

# IANA timezone matching those coordinates (default: UTC). This is not yet
# inferred from latitude/longitude. It controls the local clock/date, scene
# seasons, Time Machine timestamps, alert expiry labels, and report timing;
# coordinates themselves drive the solar geometry.
SKYSTRIP_TZ=

# Optional live-lightning feed. Blank disables strike effects (the safe
# default). If enabled, this must be a wss:// endpoint you are authorized to
# access that accepts the Blitz-compatible {"a":111} subscription and streams
# strike JSON with time (Unix epoch nanoseconds), lat, and lon. Use your own
# relay or a data service whose terms permit this use; the repo does not supply
# or authorize access to Blitzortung's restricted raw servers.
#
# This key is intentionally .env-only and is not exposed in Barkeep's config
# editor/API because the URL may carry credentials in userinfo, its path, or
# query. .env is gitignored and the installer makes it owner-only (0600);
# protect it like BUSYBAR_TOKEN. Skystrip never logs this URL, and invalid or
# insecure values are ignored with live lightning left disabled. Barkeep reads
# shared .env only at daemon startup, so restart barkeep after changing it; an
# app-only restart in the web UI cannot reload this hidden shared setting.
SKYSTRIP_LIGHTNING_WS=

# f = Fahrenheit/mph, c = Celsius/kmh (display + spoken reports)
SKYSTRIP_UNITS=f

# Clock/temperature colour: orange, pink, or red. A closed set — every
# choice is pre-proven readable against every scene and hour by hue
# separation (the contract tests sweep them all), so there is no way to
# configure an unreadable clock. Orange matches the bar's own industrial
# design; red reads hardest but is also the severe-alert colour.
SKYSTRIP_CLOCK_INK=orange

# Contact for the NWS User-Agent (their API etiquette asks for one).
# An email or URL you own. Leave blank for an anonymous UA.
# NWS is available only where api.weather.gov/points resolves the coordinates
# (principally the US and territories). Elsewhere its station, forecast, CAP
# alert, and siren layers are unavailable; Open-Meteo carries modeled weather.
SKYSTRIP_CONTACT=

# Inside NWS point coverage, pin a four-character station; blank discovers the
# nearest. Outside NWS coverage this setting has no supported effect.
SKYSTRIP_STATION=

# Comma-separated scene rotation for START. Keep at least one; barkeep's
# multiselect editor validates and stores these in the canonical order.
SKYSTRIP_SCENES=house,skyline,lakefront,forest,grove,backroads

# Kokoro voice for the spoken weather report on supported Linux. Changing this
# selects another voice from the shared bank. Linux selects `espeak-ng` if
# Kokoro cannot be imported or its model bank is unavailable; on the direct
# macOS development path a non-Kokoro name selects a `say` voice.
SKYSTRIP_VOICE=am_michael

# Kokoro speech rate multiplier. Blank = 1.0. A non-numeric value warns and
# speaks at 1.0 rather than silencing the report.
SKYSTRIP_TTS_SPEED=

# Directory holding the Kokoro model pair (kokoro-v1.0.onnx + voices-v1.0.bin).
# Blank = voices/ in the checkout. Relative paths are checkout-relative;
# absolute paths are also accepted. deploy/install.sh downloads, hashes, and
# tests the exact effective directory configured here.
SKYSTRIP_VOICE_DIR=

# How the spoken report is written:
#   plain    — straight, no character
#   chicago  — the warm, folksy cadence of a certain beloved Chicago TV
#              weatherman. Folks.
#   genz     — a stereotyped teenager. Same numbers, different delivery;
#              severe-weather alerts drop the bit and stay plain-spoken.
#              Pairs best with an expressive voice — see SKYSTRIP_VOICE.
SKYSTRIP_STYLE=plain

# When the Christmas decorations appear: off, dec25, dec24-26, dec20-jan1,
# or dec1-26 (default: dec24-26).
SKYSTRIP_CHRISTMAS=

# Require a credential on Barkeep's operational API routes. `/api/session`
# validates the token supplied for login. Loopback needs no token; any LAN bind
# should set one. Generate a dotenv-safe value from the checkout with:
#   uv run python -c 'import secrets; print(secrets.token_urlsafe(32))'
# This line is the only place the token lives: the web UI asks for it once
# per browser (read it back with `grep ^BARKEEP_TOKEN .env` on the host),
# and changing it here + restarting the daemon signs every browser out.
# See SECURITY.md before exposing the service beyond this host.
BARKEEP_TOKEN=

# Restrict barkeep to this host by default. Reach it remotely through an SSH
# tunnel, or deliberately choose a LAN address and configure BARKEEP_TOKEN.
BARKEEP_BIND=127.0.0.1

# Listen port for barkeep's UI and API. Blank = 8080.
BARKEEP_PORT=

# 5 Hz radio keepalive for a bar on Wi-Fi. Off by default because it measured
# HARMFUL under load (max draw latency 10.3 s with it, 475 ms without); set 1
# only to re-run that A/B on your own network.
BARKEEP_KEEPALIVE=

# Serve barkeep over HTTPS. BARKEEP_TLS=1 uses the optional `openssl` command
# to generate a self-signed certificate under config/tls/ on first start and
# reuses it: browsers warn, because it
# proves no identity, but the traffic — including BARKEEP_TOKEN — is
# encrypted. Point both CERT and KEY at your own files to serve a certificate
# clients trust; setting only one of them refuses startup rather than
# silently serving plaintext. Protect a supplied private key and make it
# readable by the Barkeep service account. Restart Barkeep after changing any
# TLS setting or replacing the files.
BARKEEP_TLS=
BARKEEP_TLS_CERT=
BARKEEP_TLS_KEY=

# Extra Host header names barkeep will answer to, comma-separated. It accepts
# IP literals, localhost and this machine's own name without help; add names
# here only if you reach the UI through a proxy or an alias. Refusing unknown
# names is what stops a DNS-rebinding page from driving the API.
BARKEEP_ALLOWED_HOSTS=

# How to reach the Busy Bar. Blank = USB (10.0.4.20), the default.
# For a bar on your LAN: its IP, plus the web-UI access PIN.
BUSYBAR_HOST=
BUSYBAR_TOKEN=

# Firmware 1.2.3 Auto brightness can wash out dark scenes. At Skystrip/DSN
# startup, switch Auto to this fixed percentage (blank = 35, range 1-100).
# Existing manual levels and other/unknown firmware versions stay unchanged.
# Set off to disable the workaround, then select Auto on the device to restore
# ambient adjustment. This is shared device configuration, not a per-app key;
# restart Barkeep after editing it. See docs/known-issues.md for limitations.
BUSYBAR_AUTO_BRIGHTNESS_FALLBACK=35

# Move the managed cache and state roots (blank = cache/ and state/ in the
# checkout). The installer renders these into the systemd unit's environment
# and allow-list, but the apps also read them at every start, so they work
# for manual runs too. Absolute paths; rerun deploy/install.sh after changing
# them on a systemd host so the unit's filesystem allow-list follows.
BUSYBAR_CACHE_DIR=
BUSYBAR_STATE_DIR=

# --- dsn: NASA Deep Space Network -----------------------------------------
# Seconds between polls of eyes.nasa.gov/dsn (the feed updates every 5s).
DSN_POLL_S=10
# Seconds per automatic Instrument/Distance detail; the Network action target
# is not timer-rotated (legacy rows may still page visible contacts).
DSN_ROTATE_S=20
# Default view: network, instrument, or distance. Hold the wheel to cycle.
DSN_VIEW=network
# Network layout: dishes is the explicit ground-dish/link roster; skies keeps
# the local pointing triptych; rows restores the older paged contact board.
# Restart the app after changing it.
DSN_NETWORK_STYLE=dishes
# Kokoro narration voice on supported Linux; lines are prepared ahead and
# cached on the bar. Linux selects `espeak-ng` if Kokoro cannot be imported or
# its model bank is unavailable.
DSN_VOICE=af_nova
# Optional cache subdirectory; blank uses the service-managed cache/dsn/.
# Move the managed cache root itself with BUSYBAR_CACHE_DIR when installing.
DSN_CACHE_DIR=
