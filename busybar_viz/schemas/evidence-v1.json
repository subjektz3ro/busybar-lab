{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "busybar.evidence/v1",
  "type": "object",
  "required": ["schema", "artifact_id", "scenario", "source", "passed", "evidence", "displays", "signals", "ink_references", "checks", "notes", "files"],
  "properties": {
    "schema": {"const": "busybar.evidence/v1"},
    "artifact_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scenario": {"type": "object"},
    "source": {"type": "object"},
    "passed": {"type": "boolean"},
    "evidence": {
      "type": "object",
      "required": ["automatic_level", "reviewed_level", "available_previews", "notice"],
      "properties": {
        "automatic_level": {"type": ["string", "null"]},
        "reviewed_level": {"type": ["string", "null"]},
        "available_previews": {"type": "array", "items": {"type": "string"}},
        "notice": {"type": "string"}
      }
    },
    "displays": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"enum": ["front", "back"]},
      "additionalProperties": {
        "type": "object",
        "required": ["width", "height", "pixel_format", "frame_count", "fps", "duration_us", "confidence", "frame_hashes", "baseline_hashes"]
      }
    },
    "signals": {"type": "array"},
    "ink_references": {"type": "array"},
    "checks": {"type": "array"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "files": {"type": "object"}
  }
}
